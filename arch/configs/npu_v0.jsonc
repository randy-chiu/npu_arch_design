{
  // Human/AI co-owned architecture specification.
  //
  // This file is the source of truth for Phase 0. Humans review this file to
  // judge whether the architecture is reasonable. AI agents consume this file
  // to update compiler, simulator, RTL, runtime, tests, and PPA tooling.
  //
  // Change rule:
  //   Any change here must be followed by validator/compiler/simulator/RTL/test
  //   updates as needed, then the full verification flow must pass.

  "name": "npu_v0",
  "version": 0,

  "scope": {
    // Keep Phase 0 intentionally small. These are the only graph operators the
    // compiler is allowed to lower today.
    "operators": ["matmul", "softmax", "vector_tile"],

    // Dynamic shapes are disabled so compiler legality and RTL storage sizing
    // are deterministic.
    "dynamic_shapes": false,

    // Edge tiles are disabled. Matrix dimensions must be exact multiples of
    // array_m, array_n, and k_step.
    "edge_tiles": false
  },

  "data_types": {
    // Phase 0 matmul path: int8 activations and weights, int32 accumulation.
    "activation": "int8",
    "weight": "int8",
    "accumulator": "int32",

    // Software simulator currently models softmax with fp32 math. The Phase 0
    // RTL softmax block uses an integer LUT approximation and returns Q0.8
    // probabilities; this difference is intentional until Phase 1 tightens
    // numerical equivalence.
    "softmax": "fp32"
  },

  "isa": {
    // Program format emitted by the Phase 0 compiler and consumed by the
    // functional simulator. RTL fixture generation uses the encoding below as
    // the single source of truth for binary micro-op words and SV decode
    // constants.
    "program_format": "json_uop_v0",
    "encoding": {
      "word_bits": 32,
      "opcode": {"msb": 31, "lsb": 28},
      "arg0": {"msb": 27, "lsb": 24},
      "arg1": {"msb": 23, "lsb": 20},
      "opcodes": {
        "LOAD": 1,
        "STORE": 2,
        "MATMUL": 3,
        "VREDMAX": 4,
        "VSUB": 5,
        "VEXP": 6,
        "VREDSUM": 7,
        "VDIV": 8,
        "VSCALE_FIXED": 9,
        "VCLAMP": 10,
        "VNORM": 11,
        "VADD": 12,
        "VMUL": 13,
        "VREQUANT": 14,
        "HALT": 15
      },
      "tensors": {
        "A": 0,
        "B": 1,
        "C": 2
      },
      "buffers": {
        "spad_a": 0,
        "spad_b": 1,
        "acc": 2
      },
      "buffer_aliases": {}
    },

    // Shared micro-op set required for matmul and Attention primitives.
    // Agents must update compiler, simulator, RTL decoder/control, and tests
    // whenever this list changes.
    "instructions": [
      "LOAD",
      "STORE",
      "MATMUL",
      "VREDMAX",
      "VSUB",
      "VEXP",
      "VREDSUM",
      "VDIV",
      "VSCALE_FIXED",
      "VCLAMP",
      "VNORM",
      "VADD",
      "VMUL",
      "VREQUANT",
      "HALT"
    ]
  },

  "compute": {
    // Output-stationary is easiest to verify: partial sums remain in the
    // accumulator while input tiles are consumed.
    "dataflow": "output_stationary",

    // Phase 0 tile shape. The current compiler accepts only shapes that are
    // multiples of these values.
    "array_m": 8,
    "array_n": 8,
    "k_step": 8,

    // In Phase 0 this must equal array_m * array_n. Later versions may model
    // time-multiplexed arrays where logical tile size differs from MAC lanes.
    "mac_lanes": 64,

    // Accumulator bit width for int8 x int8 products.
    "accumulator_width_bits": 32
  },

  "vector_sfu": {
    // Vector lanes used by the softmax micro-op model.
    "lanes": 8,

    // Simulator mode. RTL uses a small LUT approximation documented under
    // hw/npu_core/rtl/README.md.
    "exp_mode": "math_exp",
    "div_mode": "math_div",

    // Fixed attention numerical parameters consumed by generated RTL
    // constants. They must not be retyped as literals in Compute cluster.
    "score_scale_multiplier": 11585,
    "score_scale_shift": 15,
    "softmax_neg_inf": -2147483648,
    "softmax_clamp_low": -256,
    "softmax_clamp_high": 0,
    "softmax_normalize_shift": 9,
    "sfu_exp_input_scale": 32,
    "sfu_exp_lut_entries": 257,
    "sfu_exp_output_q": 15,
    "sfu_recip_output_q": 24,
    "sfu_rsqrt_output_q": 24,
    "sfu_bringup_exp_q15_segments": [32767, 12055, 4435, 1632, 600, 221, 81, 30, 11]
  },

  "memory": {
    // Logical memory sizes for simulator/compiler legality. The Phase 0 RTL
    // demo implements a tiny 8x8/8-element memory map, not the full DRAM size.
    "dram_bytes": 1048576,
    "scratchpad_bytes": 65536,
    "accumulator_bytes": 16384,

    // DMA and runtime allocations must be aligned to this boundary.
    "alignment_bytes": 16
  },

  "performance_contract": {
    // Performance-first architectural baseline. These are intentionally wide
    // parallel resources, not unlimited-bandwidth simulation assumptions.
    // RTL and PPA must preserve these transaction latencies until this spec is
    // explicitly revised after mapped timing/area/power evidence.
    "policy": "performance_first_declared_parallel_resources",
    "physical_timing_status": "unverified_until_mapped_sta",
    "downgrade_rule": "revise_spec_then_rebaseline_performance",
    "accumulator": {
      "implementation_assumption": "banked_register_file",
      "elements": 64,
      "element_bits": 32,
      "clear_elements_per_cycle": 64,
      "commit_elements_per_cycle": 64,
      "readout_elements_per_cycle": 64,
      "clear_cycles": 1,
      "commit_cycles": 1,
      "readout_cycles": 1,
      "commit_add_lanes": 64,
      "read_bus_bits": 2048,
      "write_bus_bits": 2048
    },
    "attention_row_storage": {
      "implementation_assumption": "eight_bank_register_file",
      "elements_per_row": 8,
      "element_bits": 32,
      "read_elements_per_cycle": 8,
      "write_elements_per_cycle": 8,
      "row_read_cycles": 1,
      "row_write_cycles": 1,
      "read_bus_bits": 256,
      "write_bus_bits": 256
    },
    "matrix_operand_feed": {
      "implementation_assumption": "banked_operand_register_file",
      "a_elements_per_cycle": 8,
      "a_element_bits": 16,
      "b_elements_per_cycle": 8,
      "b_element_bits": 8,
      "feed_cycles_per_k_slice": 1,
      "a_read_bus_bits": 128,
      "b_read_bus_bits": 64
    },
    "vector_tile_storage": {
      "implementation_assumption": "two_32bit_source_rows_plus_32bit_destination_row",
      "elements_per_segment": 8,
      "element_bits": 32,
      "source_count": 2,
      "read_elements_per_cycle": 16,
      "write_elements_per_cycle": 8,
      "source_read_cycles": 1,
      "destination_write_cycles": 1,
      "read_bus_bits": 512,
      "write_bus_bits": 256
    }
  },

  "dma": {
    // One DMA channel keeps Phase 0 scheduling serial and easy to debug.
    "channels": 1,

    // Maximum single transfer burst. Compiler/runtime must split larger moves
    // once real DMA lowering is added.
    "max_burst_bytes": 128,

    // Rank-1 contiguous copy only. 2D stride support is intentionally deferred.
    "ranks": [1]
  },

  "bus": {
    // Shared bus is enough until counters show DMA/compute contention.
    "type": "shared",
    "data_width_bits": 128
  },

  "runtime": {
    // Host-visible launch protocol. Later RTL MMIO must expose equivalent
    // control/status behavior.
    "launch_registers": ["program_base", "start", "done", "error"]
  },

  "trace_contract": {
    // Stable architectural event IDs. PPA consumes these IDs and must not
    // interpret private RTL FSM encodings.
    "command_events": {
      "NONE": 0,
      "DESC_DECODE": 1,
      "PROGRAM_MOVE": 2,
      "INPUT0_MOVE": 3,
      "INPUT1_MOVE": 4,
      "CHUNK_LAUNCH": 5,
      "COMPUTE_WAIT": 6,
      "OUTPUT_MOVE": 7,
      "JOB_RETIRE": 8,
      "ACC_CLEAR": 9,
      "ACC_DISABLE": 10,
      "PREFETCH_BANK_SELECT": 11
    },
    "scheduler_wait_reasons": {
      "NONE": 0,
      "MATRIX_RESPONSE": 1,
      "PRIMITIVE_ACCEPT": 2,
      "PRIMITIVE_RESPONSE": 3
    },
    "compute_control_events": {
      "NONE": 0,
      "PRIMITIVE_ACCEPT": 1,
      "PRIMITIVE_RESPONSE": 2,
      "ENGINE_START_ADAPTER": 3
    }
  },

  "rtl": {
    // Current RTL implementation target. This is deliberately smaller than the
    // future generated RTL system: one module, simple host write/read bus,
    // 8x8 matmul and shared Attention primitive execution.
    "top_module": "npu_v0_compute_cluster",
    "matmul_tile": [8, 8, 8],
    "matmul_array_control_cycles": 0,
    "softmax_vector_len": 8,
    "host_data_width_bits": 32,
    "host_addr_width_bits": 12,
    "host_map": {
      "a": {"base_word": 0, "words": 64},
      "b": {"base_word": 256, "words": 64},
      "c": {"base_word": 512, "words": 64},
      "mask": {"base_word": 768, "words": 2},
      "program": {"base_word": 1024, "words": 128},
      "control": {"base_word": 1280, "words": 1},
      "vector_src0": {"base_word": 1536, "words": 8},
      "vector_src1": {"base_word": 1544, "words": 8}
    },
    "control_bits": {
      "accumulate_enable": 0,
      "accumulator_clear": 1,
      "host_write_bank": 2,
      "compute_bank_select": 3
    }
  },

  "verification": {
    // Matmul must match exactly.
    "matmul_exact": true,

    // Simulator softmax tolerance. RTL softmax uses separate integer-tolerance
    // checks because it returns Q0.8 approximate probabilities.
    "softmax_abs_tolerance": 0.000001,
    "rtl_softmax_q0_8_abs_tolerance": 3
  }
}
