{
  // CPU-visible NPU wrapper register and window map.
  //
  // This file is the source of truth for wrapper-internal offsets. Generated
  // SystemVerilog and C headers should be consumed by RTL, testbenches, and
  // firmware instead of duplicating these values.

  "name": "npu_wrapper_v0",
  "version": 0,

  "addr_width_bits": 12,
  "data_width_bits": 32,

  "registers": {
    "ctrl": {
      "offset": 0,
      "description": "bit 0 write-1-to-start",
      "fields": {"start": {"bit": 0}}
    },
    "status": {
      "offset": 4,
      "description": "bit 0 done, bit 1 busy, bit 2 idle",
      "fields": {"done": {"bit": 0}, "busy": {"bit": 1}, "idle": {"bit": 2}}
    },
    "version": {
      "offset": 8,
      "description": "wrapper version register"
    },
    "irq_enable": {
      "offset": 12,
      "description": "bit 0 interrupt enable",
      "fields": {"enable": {"bit": 0}}
    },
    "irq_status": {
      "offset": 16,
      "description": "bit 0 interrupt pending, write 1 to clear",
      "fields": {"pending": {"bit": 0}}
    },
    "desc_addr": {
      "offset": 32,
      "description": "SRAM address of npu_job_desc for descriptor-driven launch"
    },
    "perf_ctrl": {
      "offset": 64,
      "description": "bit 0 write-1-to-clear retained performance snapshot while idle",
      "fields": {"clear": {"bit": 0}}
    },
    "perf_status": {
      "offset": 68,
      "description": "bit 0 snapshot valid, bit 1 counter window running, bit 2 counter overflow",
      "fields": {"valid": {"bit": 0}, "running": {"bit": 1}, "overflow": {"bit": 2}}
    },
    "perf_total_cycles": {
      "offset": 72,
      "description": "last completed launch-to-completion cycle count"
    },
    "perf_core_active_cycles": {
      "offset": 76,
      "description": "last completed core active cycle count"
    },
    "perf_core_matmul_cycles": {
      "offset": 80,
      "description": "last completed core matmul cycle count"
    },
    "perf_data_mover_active_cycles": {
      "offset": 84,
      "description": "last completed data mover active cycle count"
    },
    "perf_data_mover_setup_cycles": {
      "offset": 88,
      "description": "last completed data mover setup cycle count"
    },
    "perf_data_mover_transfer_cycles": {
      "offset": 92,
      "description": "last completed data mover valid-transfer cycle count"
    },
    "perf_data_mover_stall_cycles": {
      "offset": 96,
      "description": "last completed data mover stalled cycle count"
    },
    "perf_data_mover_words": {
      "offset": 100,
      "description": "last completed count of valid on-chip words moved"
    },
    "perf_sram_read_words": {
      "offset": 104,
      "description": "last completed count of NPU SRAM-boundary read words including descriptor reads"
    },
    "perf_sram_write_words": {
      "offset": 108,
      "description": "last completed count of NPU SRAM-boundary write words"
    },
    "perf_job_id": {
      "offset": 112,
      "description": "descriptor job identity captured with the last completed snapshot"
    },
    "perf_op_type": {
      "offset": 116,
      "description": "descriptor operation type captured with the last completed snapshot"
    },
    "perf_data_mover_read_words": {
      "offset": 120,
      "description": "last completed count of data mover SRAM-to-core-host words"
    },
    "perf_data_mover_write_words": {
      "offset": 124,
      "description": "last completed count of data mover core-host-to-SRAM words"
    },
    "perf_cmd_active_cycles": {
      "offset": 128,
      "description": "last completed command-processor active control/decode cycles"
    },
    "perf_cmd_wait_cycles": {
      "offset": 132,
      "description": "last completed command-processor wait cycles"
    },
    "perf_dm_compute_overlap_cycles": {
      "offset": 136,
      "description": "last completed cycles with data mover and compute cluster both active"
    },
    "perf_uop_sched_active_cycles": {
      "offset": 140,
      "description": "last completed common uop scheduler active cycles"
    },
    "perf_uop_sched_wait_cycles": {
      "offset": 144,
      "description": "last completed common uop scheduler engine-wait cycles"
    },
    "perf_core_wait_data_cycles": {
      "offset": 148,
      "description": "last completed K-stream cycles waiting for prefetched data"
    },
    "perf_core_local_active_cycles": {
      "offset": 152,
      "description": "last completed compute-cluster local operation active cycles"
    },
    "perf_dm_program_cycles": {
      "offset": 156,
      "description": "last completed data mover program-load cycles"
    },
    "perf_dm_initial_input_cycles": {
      "offset": 160,
      "description": "last completed data mover initial-input-load cycles"
    },
    "perf_dm_prefetch_cycles": {
      "offset": 164,
      "description": "last completed data mover next-chunk prefetch cycles"
    },
    "perf_dm_output_cycles": {
      "offset": 168,
      "description": "last completed data mover output-store cycles"
    }
  },

  "windows": {
    "a_base": {
      "offset": 256,
      "size_bytes": 256,
      "description": "Matrix A input window"
    },
    "b_base": {
      "offset": 512,
      "size_bytes": 256,
      "description": "Matrix B input window"
    },
    "c_base": {
      "offset": 768,
      "size_bytes": 256,
      "description": "Matrix C output window"
    },
    "x_base": {
      "offset": 1024,
      "size_bytes": 128,
      "description": "Softmax X input window"
    },
    "y_base": {
      "offset": 1152,
      "size_bytes": 128,
      "description": "Softmax Y output window"
    },
    "program_base": {
      "offset": 2048,
      "size_bytes": 512,
      "description": "NPU micro-op program window"
    }
  }
}
