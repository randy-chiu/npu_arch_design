{
  // Level 0 structural area proxy for the serial K-stream subsystem baseline.
  // This baseline predates A/B ping-pong and therefore has one A preload bank
  // and one B preload bank. Units are normalized, not physical area.
  "name": "area_proxy_v0_serial_k_stream",
  "version": 0,
  "evidence_level": "L0_proxy",
  "units": "normalized_area_units",
  "interpretation": "structural_proxy_not_synthesized_area",
  "design": {
    "top": "npu_subsystem",
    "variant": "npu_v0_a2_serial_k_stream"
  },
  "coefficients": {
    "int8_mac_lane": 100.0,
    "stored_bit": 0.05,
    "data_mover_lane": 25.0,
    "wrapper_control_unit": 100.0
  },
  "resources": {
    "int8_mac_lanes": 64,
    "data_mover_lanes": 4,
    "wrapper_control_units": 1,
    "storage_bits": {
      "a_preload_single": 512,
      "b_preload_single": 512,
      "spad_a": 512,
      "spad_b": 512,
      "accumulator": 2048,
      "output_window": 2048,
      "instruction_memory": 512,
      "softmax_state": 288
    }
  },
  "excludes": [
    "CPU",
    "simulation boot ROM",
    "simulation SoC SRAM",
    "external memory energy",
    "unmeasured wiring and clock tree"
  ]
}
