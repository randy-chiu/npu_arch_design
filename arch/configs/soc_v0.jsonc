{
  // Minimal SoC address map and CPU boot contract.
  //
  // This file is the source of truth for SoC-level addresses. NPU-wrapper
  // internal register/window offsets are owned by
  // arch/configs/npu_wrapper_v0.jsonc.

  "name": "soc_v0",
  "version": 0,

  "cpu": {
    "core": "picorv32",
    "reset_vector": 0,
    "stack_pointer": 262128
  },

  "bus": {
    "addr_width_bits": 32,
    "data_width_bits": 32
  },

  "memory_map": {
    "boot_rom": {
      "base": 0,
      "size_bytes": 32768,
      "description": "Simulation boot ROM. Current bring-up stores the full firmware image here, including start code, driver, main, and generated test data. Watch size growth; a later flash/loader flow should avoid requiring all software to fit in ROM."
    },
    "sram": {
      "base": 131072,
      "size_bytes": 131072,
      "description": "CPU writable data memory for stack, locals, and future runtime buffers/descriptors. Current smoke keeps static firmware/test data in boot ROM; future NPU data/program buffers should be staged here for NPU fetch."
    },
    "npu_wrapper": {
      "base": 268435456,
      "size_bytes": 4096,
      "description": "CPU-visible NPU wrapper MMIO window"
    },
    "uart": {
      "base": 536870912,
      "size_bytes": 4096,
      "description": "Reserved debug UART window"
    },
    "test_status": {
      "base": 805306368,
      "size_bytes": 16,
      "description": "Simulation pass/fail status register"
    }
  },

  "boot": {
    "rom_init_hex": "build/firmware/soc_cpu_smoke.hex"
  },

  "abi": {
    "npu_job_desc": {
      "description": "CPU firmware produces this descriptor in SRAM. The NPU wrapper consumes it through DESC_ADDR, fetches program/input buffers, runs the NPU core, and writes output buffers back to SRAM.",
      "fields": [
        {"name": "op_type", "word": 0},
        {"name": "program_addr", "word": 1},
        {"name": "program_words", "word": 2},
        {"name": "input0_addr", "word": 3},
        {"name": "input0_words", "word": 4},
        {"name": "input1_addr", "word": 5},
        {"name": "input1_words", "word": 6},
        {"name": "output_addr", "word": 7},
        {"name": "output_words", "word": 8}
      ],
      "op_types": {
        "matmul": 1,
        "softmax": 2
      }
    }
  }
}
