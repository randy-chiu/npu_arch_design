{
  // Minimal SoC address map and CPU boot contract.
  //
  // This file is the source of truth for SoC-level addresses. NPU-wrapper
  // internal register/window offsets are owned by
  // arch/configs/npu_wrapper_v0.jsonc.

  "name": "soc_v0",
  "version": 0,

  "cpu": {
    "core": "picorv32",
    "reset_vector": 0,
    "stack_pointer": 12582704
  },

  "bus": {
    "addr_width_bits": 32,
    "data_width_bits": 32,
    "sram_cpu_lanes": 4,
    "sram_cpu_data_width_bits": 128
  },

  "npu_data_mover": {
    "core_host_lanes": 4,
    "sram_npu_lanes": 4,
    "words_per_cycle": 4,
    "setup_cycles": 0,
    "model_setup_cycles_per_segment": 1,
    "description": "NPU-side SRAM/data-mover/core-host movement shape. words_per_cycle must be in 1..min(core_host_lanes, sram_npu_lanes). Lane i maps to word address base + i."
  },

  "memory_map": {
    "boot_rom": {
      "base": 0,
      "size_bytes": 8388608,
      "description": "Simulation boot ROM. Current bring-up stores the full firmware image here, including start code, driver, main, and generated test data. This is intentionally oversized for full FC1 16-N-tile K-stream bring-up; a later flash/loader flow should avoid requiring all software to fit in ROM."
    },
    "sram": {
      "base": 8388608,
      "size_bytes": 4194304,
      "description": "CPU writable data memory for stack, locals, descriptors, and staged NPU buffers. This is intentionally oversized for full FC1 16-N-tile K-stream bring-up."
    },
    "npu_wrapper": {
      "base": 268435456,
      "size_bytes": 4096,
      "description": "CPU-visible NPU wrapper MMIO window"
    },
    "dma": {
      "base": 1073741824,
      "size_bytes": 4096,
      "description": "CPU-configured simulation DMA for ROM/flash-to-SRAM staging. The first implementation reads the boot ROM image and writes the wide SRAM CPU/preload port."
    },
    "uart": {
      "base": 536870912,
      "size_bytes": 4096,
      "description": "Reserved debug UART window"
    },
    "test_status": {
      "base": 805306368,
      "size_bytes": 16,
      "description": "Simulation pass/fail status register"
    }
  },

  "boot": {
    "rom_init_hex": "build/firmware/soc_cpu_smoke.hex"
  },

  "peripherals": {
    "dma": {
      "registers": {
        "ctrl": {
          "offset": 0,
          "fields": {"start": {"bit": 0}}
        },
        "status": {
          "offset": 4,
          "fields": {
            "done": {"bit": 0},
            "busy": {"bit": 1},
            "idle": {"bit": 2}
          }
        },
        "src": 8,
        "dst": 12,
        "words": 16
      }
    },
    "test_status": {
      "pass": 1,
      "fail": 4294967295,
      "fail_code_flag": 2147483648
    }
  },

  "abi": {
    "npu_job_desc": {
      "description": "CPU firmware produces this descriptor in SRAM. The NPU wrapper consumes it through DESC_ADDR, fetches program/input buffers, runs the NPU core, and writes output buffers back to SRAM.",
      "fields": [
        {"name": "op_type", "word": 0},
        {"name": "program_addr", "word": 1},
        {"name": "program_words", "word": 2},
        {"name": "input0_addr", "word": 3},
        {"name": "input0_words", "word": 4},
        {"name": "input1_addr", "word": 5},
        {"name": "input1_words", "word": 6},
        {"name": "output_addr", "word": 7},
        {"name": "output_words", "word": 8},
        {"name": "k_chunks", "word": 9},
        {"name": "job_id", "word": 10}
      ],
      "op_types": {
        "matmul": 1,
        "softmax": 2,
        "matmul_k_stream": 3,
        "attention_softmax_v1": 4,
        "matmul_u16s8_q15": 5,
        "attention_scale_mask_v1": 6
      }
    }
  }
}
