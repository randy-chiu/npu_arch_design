{
  "name": "phase0_intrinsics",
  "description": "Phase 0 operator lowering templates expressed in the current NPU core ISA/uop vocabulary.",
  "operators": {
    "matmul": {
      "inputs": ["a", "b"],
      "outputs": ["out"],
      "instructions": [
        {"op": "LOAD", "tensor": "$a", "buffer": "spad_a"},
        {"op": "LOAD", "tensor": "$b", "buffer": "spad_b"},
        {"op": "MATMUL", "a": "spad_a", "b": "spad_b", "out": "acc_$out", "shape": "$shape"},
        {"op": "STORE", "tensor": "$out", "buffer": "acc_$out"}
      ]
    }
  }
}
