      "x": "Fc1Relu",
      "weight": "fc2.weight",
      "bias": "fc2.bias",
      "out": "Logits",
      "input_shape": [128],
      "weight_shape": [10, 128],
      "bias_shape": [10],
      "output_shape": [10],
      "in_features": 128,
      "out_features": 10
    },
    {"type": "argmax", "x": "Logits", "out": "Predicted", "input_shape": [10], "output_shape": []}
