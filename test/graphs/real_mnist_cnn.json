{
  "description": "Open-source pretrained MNIST CNN from cmaeti/mnist-cnn.",
  "source": "https://huggingface.co/cmaeti/mnist-cnn",
  "weights": "test/external/mnist_cnn/mnist-cnn.safetensors",
  "parameters": {
